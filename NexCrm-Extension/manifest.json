{
  "manifest_version": 3,
  "name": "Data Vista Sync",
  "version": "1.0",
  "description": "Auto-imports downloaded Amazon Seller Central reports directly into Data Vista CRM.",
  "permissions": [
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "file:///*",
    "https://data-vista-crm.onrender.com/*",
    "http://localhost:5247/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
