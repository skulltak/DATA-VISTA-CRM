{
  "manifest_version": 3,
  "name": "Data Vista Sync",
  "version": "1.0",
  "description": "Auto-imports downloaded Amazon Seller Central reports directly into Data Vista CRM.",
  "permissions": [
    "downloads",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "file:///*",
    "https://data-vista-crm.onrender.com/*",
    "https://data-vista-crm-1.onrender.com/*",
    "https://sellercentral.amazon.in/*",
    "https://datavistavecare.netlify.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://datavistavecare.netlify.app/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
